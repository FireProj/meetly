rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isMember(groupId);
      allow delete: if isSignedIn() && request.auth.uid == resource.data.createdBy;

      match /events/{eventId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId);
        allow update: if isMember(groupId);
        allow delete: if isMember(groupId) && request.auth.uid == resource.data.createdBy;

        match /votes/{voteId} {
          allow read: if isMember(groupId);
          allow create, update: if isMember(groupId) && request.auth.uid == voteId;
          allow delete: if isMember(groupId) && request.auth.uid == voteId;
        }
      }
    }
  }
}
